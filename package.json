{
  "name": "@cr7258/memory-elasticsearch",
  "version": "0.0.2",
  "type": "module",
  "description": "Elasticsearch-backed long-term memory plugin for OpenClaw with BM25 + vector hybrid retrieval.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.4.24",
      "minGatewayVersion": ">=2026.4.24"
    },
    "build": {
      "openclawVersion": "2026.5.27"
    },
    "install": {
      "npmSpec": "@cr7258/memory-elasticsearch"
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  }
}
